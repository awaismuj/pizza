PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public genzpizza.online storefront (the online-store app). Added to CORS
# automatically so it can reach this API.
STORE_URL=http://localhost:5174
BACKEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/pos-db
JWT_SECRET=change_this_to_a_long_random_secret_key
# Keep this unique secret stable across deployments so payment/checkout retry
# keys remain valid if JWT_SECRET is rotated. If blank, JWT_SECRET is used.
IDEMPOTENCY_SECRET=

ADMIN_NAME=System Admin
ADMIN_EMAIL=devops.awais@gmail.com
ADMIN_PHONE=9999999999
# Leave blank to avoid creating a fresh account with a default password.
# Supply an operator-selected unique password only when bootstrapping a new DB.
ADMIN_PASSWORD=

# Where new-signup approval requests are emailed
ADMIN_APPROVAL_EMAIL=awais.muj@gmail.com

# SMTP credentials used to send that approval email. With Gmail, use an
# "App Password" (not your normal password) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp daily report (free — no API key/cost, see services/whatsappService.js) ----
WHATSAPP_ENABLED=true
# Number the report is sent to, international format, no "+", e.g. 923001234567
WHATSAPP_TARGET_NUMBER=923456051526

# ---- WhatsApp customer coupon campaigns ----
# "linked" sends from the WhatsApp account scanned in Dashboard → Send Coupons.
# This uses unofficial WhatsApp Web automation and carries account restriction risk;
# use only for opted-in customers and modest message volume. "cloud" is Meta's
# official Business API and requires an approved template and credentials.
# "mock" is for development/tests only and never delivers real messages.
WHATSAPP_CAMPAIGN_PROVIDER=linked
WHATSAPP_CLOUD_API_VERSION=v22.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CAMPAIGN_TEMPLATE_NAME=
WHATSAPP_CAMPAIGN_TEMPLATE_LANGUAGE=en
WHATSAPP_CAMPAIGN_TEMPLATE_PREVIEW=Hi {{1}}! 🍕 Enjoy a special treat from our pizza shop!\n\nYour exclusive discount: {{2}}% OFF\nCoupon Code: {{3}}\nMinimum Order: Rs. {{4}}\nValid Until: {{5}}\n\nOrder now and enjoy your pizza!
WHATSAPP_CAMPAIGN_TEST_NUMBER=
WHATSAPP_CAMPAIGN_DEFAULT_COUNTRY_CODE=92
WHATSAPP_CAMPAIGN_MESSAGES_PER_SECOND=1
# Auto-send the previous day's report at this local server time if nobody
# sent/downloaded it manually that day (24h clock, minute 0-59).
REPORT_AUTO_SEND=true
REPORT_AUTO_SEND_HOUR=0
REPORT_AUTO_SEND_MINUTE=5
# --- Order prep countdown: TEST HOOKS (ignored when NODE_ENV=production) ---
# New orders get a countdown of this many SECONDS instead of the saved default
# (does not change the saved default). Handy for watching the mascot alerts.
# PREP_TEST_DURATION_SECONDS=90
# Runs the server's prep clock this many seconds ahead of real time.
# PREP_CLOCK_OFFSET_SECONDS=600
